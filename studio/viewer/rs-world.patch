+        for(const [x,z,endX,endZ] of edges){const steps=Math.ceil(Math.hypot(endX-x,endZ-z)/8);for(let i=0;i<steps;i++){
+            const x1=x+(endX-x)*i/steps,z1=z+(endZ-z)*i/steps,x2=x+(endX-x)*(i+1)/steps,z2=z+(endZ-z)*(i+1)/steps;
+            if(intersects(Math.min(x1,x2),Math.min(z1,z2),Math.abs(x2-x1),Math.abs(z2-z1)))result.push({points:[[x1,z1],[x2,z2]],color:c,alpha:settings.opacity,fill:false,dashed:!fresh});
+        }}
+    }
+    return result;
+}
