@@ -0,0 +1,12 @@
+import type {PlayerAppearance} from './PlayerAppearance';
+const SLOTS=['Head','Cape','Neck','Weapon','Body','Shield','Arms','Legs','Hair','Hands','Feet','Beard'];
+/** Appearance contains equipment IDs offset by 512, distinct from identity kits. */
+export function observedEquipment(appearance:PlayerAppearance|undefined,resolveName:(id:number)=>string|undefined){
+ if(!appearance||appearance.transmog>=0)return [];
+ return appearance.parts.flatMap((part,slot)=>{
+  if(!Number.isInteger(part)||part<512||part===65535)return [];
+  const id=part-512;let name:string|undefined;
+  try{name=resolveName(id);}catch{}
+  return [{id,slot:SLOTS[slot]??'Equipment',name:name||'Item #'+id}];
+ });
+}
