diff --git a/src/components/rs/worldmap/WorldMapTiles.ts b/src/components/rs/worldmap/WorldMapTiles.ts
new file mode 100644
index 0000000..6fa4a79
--- /dev/null
+++ b/src/components/rs/worldmap/WorldMapTiles.ts
@@ -0,0 +1,60 @@
+export interface AtlasTile {
+    id: number;
+    mapX: number;
+    mapY: number;
+    left: number;
+    bottom: number;
+    size: number;
+}
+
+// One viewport calculation, reused while asynchronous tile generation finishes.
+export function visibleAtlasTiles(width: number, height: number, posX: number, posY: number, tileSize: number): AtlasTile[] {
+    if (width <= 0 || height <= 0 || tileSize <= 0) return [];
+    const halfWidth = (width / 2) | 0, halfHeight = (height / 2) | 0;
+    const size = 64 * tileSize;
+    const x = halfWidth - ((posX | 0) % 64) * tileSize - tileSize / 2;
+    const y = halfHeight - ((posY | 0) % 64) * tileSize - tileSize / 2;
+    const startX = -Math.ceil(x / size) - 1, startY = -Math.ceil(y / size) - 1;
+    const endX = Math.ceil((width - x) / size) + 1, endY = Math.ceil((height - y) / size) + 1;
+    const tiles: AtlasTile[] = [];
+    for (let rx = startX; rx < endX; rx++) {
+        for (let ry = startY; ry < endY; ry++) {
+            const mapX = (posX >> 6) + rx, mapY = (posY >> 6) + ry;
+            if (mapX < 0 || mapY < 0 || mapX >= 100 || mapY >= 200) continue;
+            tiles.push({id: (mapX << 8) + mapY, mapX, mapY, left: x + rx * size, bottom: y + ry * size, size});
+        }
+    }
+    const distance = (t: AtlasTile) => (t.left + size / 2 - halfWidth) ** 2 + (t.bottom + size / 2 - halfHeight) ** 2;
+    return tiles.sort((a, b) => distance(a) - distance(b));
+}
+
+// Terrain is static between arriving tiles; player dots need only 10 updates/sec.
+export class AtlasFrameState {
+    private urls: readonly (string | undefined)[] | undefined;
+    private lastMarkersAt = -Infinity;
+    reset(): void { this.urls = undefined; this.lastMarkersAt = -Infinity; }
+    terrainChanged(urls: readonly (string | undefined)[]): boolean {
+        if (this.urls && this.urls.length === urls.length && urls.every((url, i) => url === this.urls![i])) return false;
+        this.urls = urls;
+        return true;
+    }
+    markersDue(time: number): boolean {
+        if (time - this.lastMarkersAt < 100) return false;
+        this.lastMarkersAt = time;
+        return true;
+    }
+}
+
+export interface AtlasArea {
+    id: string;
+    label: string;
+    minX: number;
+    maxX: number;
+    minY: number;
+    maxY: number;
+}
+export function atlasAreaView(area: AtlasArea, width: number, height: number, tileSizes: readonly number[]) {
+    const fit = Math.min(width / (area.maxX - area.minX), height / (area.maxY - area.minY)) * 0.9;
+    const fitting = tileSizes.filter(size => size <= fit);
+    return {x: (area.minX + area.maxX) / 2, y: (area.minY + area.maxY) / 2, tileSize: fitting[fitting.length - 1] ?? tileSizes[0]};
+}
