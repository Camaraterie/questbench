 }
+
+.worldmap-atlas-status { position:absolute; top:8px; left:8px; z-index:5; max-width:calc(100% - 70px); display:flex; align-items:center; flex-wrap:wrap; gap:6px; color:#c3d4f4; font:12px ui-sans-serif,system-ui,sans-serif; }
