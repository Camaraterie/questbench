new file mode 100644
index 0000000..2700edb
--- /dev/null
+++ b/src/components/rs/worldmap/AtlasLayers.ts
@@ -0,0 +1,8 @@
+export type AtlasLayer = 'surface' | 'dungeons';
+export const atlasLayerFor = (y:number): AtlasLayer => y>=6400?'dungeons':'surface';
+export function layerPosition(layer:AtlasLayer, position:{x:number;y:number}) {
+    return {x:position.x,y:atlasLayerFor(position.y)===layer?position.y:position.y+(layer==='dungeons'?6400:-6400)};
+}
+export function layerTileVisible(layer:AtlasLayer|undefined,mapY:number):boolean {
+    return !layer || (mapY>=100)===(layer==='dungeons');
+}
