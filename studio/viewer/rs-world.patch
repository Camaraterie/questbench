@@ -0,0 +1,74 @@
+/** Bounded, observation-only overlays shared by the atlas and 3D renderer. */
+export type LayerSettings = {presence:boolean;trails:boolean;coverage:boolean;opacity:number};
+export const defaultLayers:LayerSettings={presence:true,trails:true,coverage:true,opacity:0.45};
+export function layerSettings(value:unknown):LayerSettings {
+    const v=value && typeof value==='object'?value as Partial<LayerSettings>:{};
+    return {presence:typeof v.presence==='boolean'?v.presence:true,trails:typeof v.trails==='boolean'?v.trails:true,coverage:typeof v.coverage==='boolean'?v.coverage:true,opacity:typeof v.opacity==='number'&&Number.isFinite(v.opacity)?Math.max(.1,Math.min(.9,v.opacity)):.45};
+}
+export function readLayers(key:string):LayerSettings {try{return layerSettings(JSON.parse(localStorage.getItem(key)??'null'));}catch{return {...defaultLayers};}}
+export type ResearchPlayer={name:string;x:number;z:number;plane:number};
+export type TrailSegment={name:string;x:number;z:number;endX:number;endZ:number;plane:number;at:number};
+export type ResearchSource={rosterAt:number;detailAt:number;connected:boolean;players:ResearchPlayer[];trails:TrailSegment[];area?:{x:number;z:number;w:number;h:number};truncated:boolean};
+export const researchView:{settings:LayerSettings;source?:ResearchSource}={settings:{...defaultLayers}};
+export const TRAIL_WINDOW=300000, SAMPLE_INTERVAL=15000;
+const key=(name:string)=>name.toLowerCase().replace(/[_ -]/g,'');
+export class MovementSamples {
+    private previous=new Map<string,ResearchPlayer & {at:number}>();
+    private segments:TrailSegment[]=[];
+    private sampledAt=0;
+    sample(players:ResearchPlayer[],at:number,fresh:boolean):TrailSegment[] {
+        this.segments=this.segments.filter(s=>s.at>=at-TRAIL_WINDOW);
+        if(!fresh){this.previous.clear();return this.segments;}
+        if(at-this.sampledAt<SAMPLE_INTERVAL)return this.segments;
+        const next=new Map<string,ResearchPlayer & {at:number}>();
+        for(const p of players.slice(0,5000)) {
+            if(!validPlayer(p))continue;
+            const id=key(p.name),old=this.previous.get(id);next.set(id,{...p,at});
+            // Never join floor changes, outages, teleports or missing observations.
+            if(old&&old.plane===p.plane&&at-old.at<=30000&&at>old.at) {
+                const distance=Math.hypot(p.x-old.x,p.z-old.z);
+                if(distance>0&&distance<=64)this.segments.push({name:p.name,x:old.x,z:old.z,endX:p.x,endZ:p.z,plane:p.plane,at});
+            }
