+            if(s.plane!==plane||age<0||age>TRAIL_WINDOW||!visible(s.name)||!intersects(Math.min(s.x,s.endX),Math.min(s.z,s.endZ),Math.abs(s.endX-s.x),Math.abs(s.endZ-s.z)))continue;
