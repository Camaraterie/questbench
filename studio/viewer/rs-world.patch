diff --git a/src/components/rs/worldmap/AtlasMarkers.ts b/src/components/rs/worldmap/AtlasMarkers.ts
new file mode 100644
index 0000000..921614c
--- /dev/null
+++ b/src/components/rs/worldmap/AtlasMarkers.ts
@@ -0,0 +1,31 @@
+export type AtlasMarker={key:string;x:number;y:number;label:string;color:string;plane?:number};
+export type MarkerGroup={key:string;x:number;y:number;color:string;members:AtlasMarker[]};
+/** Cluster in fixed world cells sized for the current zoom, so panning doesn't reshuffle groups. */
+export function atlasMarkerGroups(markers:AtlasMarker[],tileSize:number):MarkerGroup[]{
+    if(tileSize>=1.5)return markers.map(marker=>({...marker,members:[marker]}));
+    const size=32/tileSize,groups=new Map<string,MarkerGroup>();
+    for(const marker of markers){
+        if(!Number.isFinite(marker.x)||!Number.isFinite(marker.y))continue;
+        const key=marker.key==='camera'?marker.key:`${marker.plane??0}:${Math.floor(marker.x/size)}:${Math.floor(marker.y/size)}`;
+        const existing=groups.get(key);
+        if(existing){const n=existing.members.length;existing.x=(existing.x*n+marker.x)/(n+1);existing.y=(existing.y*n+marker.y)/(n+1);existing.members.push(marker);if(existing.color!==marker.color)existing.color='#a8b1c1';}
+        else groups.set(key,{key,x:marker.x,y:marker.y,color:marker.color,members:[marker]});
+    }
+    return [...groups.values()];
+}
+/** Start compact maps at the busiest local region, not the full cache including distant outliers. */
+export function atlasActivityView(markers:AtlasMarker[],width:number,height:number,tileSizes:readonly number[]){
+    const cells=new Map<string,AtlasMarker[]>();
+    for(const marker of markers){
+        if(marker.key==='camera'||!Number.isFinite(marker.x)||!Number.isFinite(marker.y))continue;
+        const key=`${Math.floor(marker.x/64)}:${Math.floor(marker.y/64)}`;
+        const cell=cells.get(key);if(cell)cell.push(marker);else cells.set(key,[marker]);
+    }
+    const busiest=[...cells.values()].sort((a,b)=>b.length-a.length)[0];
+    if(!busiest||width<=0||height<=0)return undefined;
+    const x=busiest.reduce((sum,p)=>sum+p.x,0)/busiest.length,y=busiest.reduce((sum,p)=>sum+p.y,0)/busiest.length;
+    // Neighborhood scale: keep players and nearby buildings legible, even in short panels.
+    const desired=Math.max(3,Math.min(6,width/128,height/64));
+    const sizes=tileSizes.filter(size=>size<=desired);
+    return {x,y,tileSize:sizes[sizes.length-1]??tileSizes[0]};
+}
diff --git a/src/live/AtlasCombatPreference.ts b/src/live/AtlasCombatPreference.ts
new file mode 100644
index 0000000..de89701
--- /dev/null
+++ b/src/live/AtlasCombatPreference.ts
@@ -0,0 +1,16 @@
+export const ATLAS_COMBAT_KEY = 'rs-watch:atlas-multi';
+const CHANGE_EVENT = 'rs-watch:atlas-multi-change';
+export function readAtlasCombat(storage?:Pick<Storage,'getItem'>):boolean {
+    try{return (storage??window.localStorage).getItem(ATLAS_COMBAT_KEY)!=='false';}catch{return true;}
+}
+export function writeAtlasCombat(enabled:boolean,storage:Pick<Storage,'setItem'>|undefined = undefined,target:EventTarget = window):void {
+    try{(storage??window.localStorage).setItem(ATLAS_COMBAT_KEY,String(enabled));}catch{}
+    // Storage events reach other same-origin frames; this event reaches this document.
+    target.dispatchEvent(new CustomEvent(CHANGE_EVENT,{detail:enabled}));
+}
+export function subscribeAtlasCombat(onChange:(enabled:boolean)=>void,target:EventTarget = window):()=>void {
+    const local=(event:Event)=>onChange((event as CustomEvent<boolean>).detail);
+    const remote=(event:Event)=>{const storageEvent=event as StorageEvent;if(storageEvent.key===ATLAS_COMBAT_KEY||storageEvent.key===null)onChange(storageEvent.newValue!=='false');};
+    target.addEventListener(CHANGE_EVENT,local);target.addEventListener('storage',remote);
+    return()=>{target.removeEventListener(CHANGE_EVENT,local);target.removeEventListener('storage',remote);};
+}
diff --git a/src/live/MultiCombat.ts b/src/live/MultiCombat.ts
new file mode 100644
