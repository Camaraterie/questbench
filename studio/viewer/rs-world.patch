+        }
+    }
+    const a=source.area;
+    if(settings.coverage&&a&&[a.x,a.z,a.w,a.h].every(Number.isFinite)&&a.w>0&&a.w<=384&&a.h>0&&a.h<=384&&intersects(a.x,a.z,a.w,a.h)) {
+        const fresh=detailFresh(source,now),c=fresh?'#7ce2ff':'#a8b1c1';
+        const edges:[number,number,number,number][]=[[a.x,a.z,a.x+a.w,a.z],[a.x+a.w,a.z,a.x+a.w,a.z+a.h],[a.x+a.w,a.z+a.h,a.x,a.z+a.h],[a.x,a.z+a.h,a.x,a.z]];
