+export type WheelIntent = {kind:'browser'|'scroll'|'zoom';x:number;y:number};
+/** Embedded viewers reserve ordinary wheel input for the host's scroll wall. */
+export function wheelIntent(event:{deltaX:number;deltaY:number;deltaMode:number;altKey:boolean;ctrlKey:boolean;metaKey:boolean},embedded:boolean):WheelIntent {
+    const scale=event.deltaMode===1?16:event.deltaMode===2?400:1;
+    const bounded=(value:number)=>Number.isFinite(value)?Math.max(-400,Math.min(400,value*scale)):0;
+    const x=bounded(event.deltaX),y=bounded(event.deltaY);
+    if(event.ctrlKey||event.metaKey)return {kind:'browser',x:0,y:0};
+    return {kind:embedded&&!event.altKey?'scroll':'zoom',x,y:embedded&&event.altKey?Math.max(-60,Math.min(60,y*.35)):y};
+}
