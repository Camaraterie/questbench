--- /dev/null
+++ b/src/live/MultiCombat.ts
@@ -0,0 +1,25 @@
+import data from './multi-combat-data.json';
+
+export const multiCombatSource = {path:data.source, sha256:data.sha256, liveVerified:false};
+export const MULTI_COMBAT_NOTE = 'Local game-source boundaries; live server revision unverified. Multi-combat is not a PvP or safety indicator.';
+export const multiCombatZones = data.zones as [number, number, number][];
+const key = (plane:number,x:number,z:number) => `${plane}:${Math.floor(x/8)}:${Math.floor(z/8)}`;
+const zoneKeys = new Set(multiCombatZones.map(([plane,x,z])=>key(plane,x,z)));
+export function isMultiCombat(x:number,z:number,plane:number):boolean|null {
+    if(!Number.isFinite(x)||!Number.isFinite(z)||x<0||z<0||x>=16384||z>=16384||!Number.isInteger(plane)||plane<0||plane>3)return null;
+    return zoneKeys.has(key(plane,x,z));
+}
+export function combatZoneStatus(position:{x:number;z:number;plane:number}|undefined,fresh:boolean):'MULTI'|'SINGLE'|'UNKNOWN' {
+    if(!fresh||!position)return 'UNKNOWN';
+    const multi=isMultiCombat(position.x,position.z,position.plane);
+    return multi===null?'UNKNOWN':multi?'MULTI':'SINGLE';
+}
+// Each iframe owns its floor and visibility preference; new views start enabled.
+export const multiCombatView = {enabled:true,plane:0};
+// Horizontal strips keep the atlas inexpensive even at a whole-world zoom.
+export const multiCombatStrips:{plane:number;x:number;z:number;width:number}[]=[];
+for(const [plane,x,z] of [...multiCombatZones].sort((a,b)=>a[0]-b[0]||a[2]-b[2]||a[1]-b[1])) {
+    const last=multiCombatStrips[multiCombatStrips.length-1];
+    if(last&&last.plane===plane&&last.z===z&&last.x+last.width===x)last.width+=8;
+    else multiCombatStrips.push({plane,x,z,width:8});
+}
diff --git a/src/live/ResearchLayers.ts b/src/live/ResearchLayers.ts
