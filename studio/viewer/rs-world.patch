diff --git a/src/live/Allegiance.ts b/src/live/Allegiance.ts
new file mode 100644
index 0000000..daefc44
--- /dev/null
+++ b/src/live/Allegiance.ts
@@ -0,0 +1,29 @@
+let names = new Set<string>();
+let ready = false;
+let receivedAt = 0;
+let onlyFriendlies = false;
+let visibleNames: Set<string> | undefined;
+const key=(name:string)=>name.trim().toLowerCase().replace(/[_ -]/g,'');
+export function setAllegiances(value:{names:string[];ready:boolean;onlyFriendlies?:boolean;visibleNames?:string[]}) {
+    names=new Set(value.names.filter(n=>typeof n==='string').map(key));
+    ready=value.ready===true;receivedAt=Date.now();
+    onlyFriendlies=value.onlyFriendlies===true;
+    visibleNames=Array.isArray(value.visibleNames)?new Set(value.visibleNames.filter(n=>typeof n==='string').map(key)):undefined;
+}
+export function playerAllegiance(name:string):'friendly'|'enemy'|'unknown' {
+    if(Date.now()-receivedAt>120000)return 'unknown';
+    if(names.has(key(name)))return 'friendly';
+    return ready?'enemy':'unknown';
+}
+export function playerColor(name:string) {
+    const relation=playerAllegiance(name);
+    return relation==='friendly'?'#6ee7a0':relation==='enemy'?'#ff7777':'#a8b1c1';
+}
+
+export function playerVisible(name:string):boolean {
+    return (!visibleNames || visibleNames.has(key(name))) && (!onlyFriendlies || playerAllegiance(name)==='friendly');
+}
+
+export function friendlyRosterReady():boolean {
+    return ready && Date.now()-receivedAt<=120000;
+}
