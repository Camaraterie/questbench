+export function researchShapes(source:ResearchSource|undefined,settings:LayerSettings,plane:number,bounds:{minX:number;maxX:number;minZ:number;maxZ:number},color:(name:string)=>string,visible:(name:string)=>boolean=()=>true,now=Date.now()):LayerShape[] {
