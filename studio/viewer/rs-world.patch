@@ -0,0 +1,18 @@
+import { AtlasArea } from "../components/rs/worldmap/WorldMapTiles";
+export function parseAtlasManifest(value: any, cacheName: string): {urls: Map<number,string>; areas: AtlasArea[]} {
+    if (!value || value.format !== 1 || value.complete !== true || value.plane !== 0 || value.cacheName !== cacheName ||
+        typeof value.version !== "string" || !/^[a-f0-9]{16}$/.test(value.version) || !Array.isArray(value.tiles) || value.tiles.length > 20000 ||
+        !Array.isArray(value.areas) || value.areas.length > 10) throw Error("Atlas does not match the loaded game cache");
+    const urls = new Map<number,string>();
+    for (const id of value.tiles) {
+        const x = id >> 8, y = id & 255;
+        if (!Number.isInteger(id) || id < 0 || id >= 100 * 256 || x >= 100 || y >= 200 || urls.has(id)) throw Error("Invalid atlas tile");
+        urls.set(id, `/viewer/atlas/${value.version}/${x}_${y}.png`);
+    }
+    const areas: AtlasArea[] = value.areas.map((a:any) => {
+        if (!a || typeof a.id !== "string" || typeof a.label !== "string" || a.label.length > 40 ||
+            ![a.minX,a.maxX,a.minY,a.maxY].every(Number.isFinite) || a.minX < 0 || a.minY < 0 || a.maxX > 6400 || a.maxY > 12800 || a.minX >= a.maxX || a.minY >= a.maxY) throw Error("Invalid atlas area");
+        return {id:a.id,label:a.label,minX:a.minX,maxX:a.maxX,minY:a.minY,maxY:a.maxY};
+    });
+    return {urls,areas};
+}
