+import { useEffect, useRef, useState } from "react";
+import { FlightLayers, flightLayer, FlightLayer } from "./FlightLayers";
+import { MapViewer } from "./MapViewer";
+
+export function FlightLayerControls({ mapViewer }: { mapViewer: MapViewer }): JSX.Element {
+    const history = useRef(new FlightLayers());
+    const [layer, setLayer] = useState(() => flightLayer(mapViewer.camera.getPosZ()));
+    const [notice, setNotice] = useState("");
+    useEffect(() => {
+        const timer = window.setInterval(() => setLayer(flightLayer(mapViewer.camera.getPosZ())), 250);
+        return () => window.clearInterval(timer);
+    }, [mapViewer]);
+    function switchLayer(target: FlightLayer) {
+        const camera = mapViewer.camera;
+        const next = history.current.switchTo(target, {
+            x: camera.getPosX(), y: camera.getPosY(), z: camera.getPosZ(),
+            pitch: camera.pitch, yaw: camera.yaw,
+        }, (x, z) => mapViewer.mapFileIndex.getTerrainArchiveId(x, z) !== -1);
+        if (!next) {
+            setNotice(flightLayer(camera.getPosZ()) === target ? "" : "No mapped terrain available");
+            return;
+        }
+        mapViewer.live?.unfollow();
+        if (mapViewer.live) mapViewer.live.pendingFollow = undefined;
+        mapViewer.setCamera({ position: [next.x, next.y, next.z], pitch: next.pitch, yaw: next.yaw });
+        mapViewer.updateSearchParams();
+        setLayer(target);
+        setNotice("");
+        mapViewer.renderer.canvas.focus({ preventScroll: true });
+    }
+    return <div className="flight-layers">
+        <div role="group" aria-label="3D map layer">
+            <button type="button" aria-pressed={layer === "surface"}
+                title="Return to your last surface view, or the nearest mapped surface area"
+                onClick={() => switchLayer("surface")}>↑ Surface</button>
+            <button type="button" aria-pressed={layer === "dungeons"}
+                title="Return to your last dungeon view, or the nearest mapped underground area"
+                onClick={() => switchLayer("dungeons")}>↓ Dungeons</button>
+        </div>
+        <small role="status">{notice || "Fly camera · remembers each view"}</small>
+    </div>;
+}
diff --git a/src/mapviewer/FlightLayers.ts b/src/mapviewer/FlightLayers.ts
new file mode 100644
index 0000000..7c266f4
--- /dev/null
+++ b/src/mapviewer/FlightLayers.ts
@@ -0,0 +1,41 @@
+export type FlightLayer = "surface" | "dungeons";
+export type FlightView = { x: number; y: number; z: number; pitch: number; yaw: number };
+
+export function flightLayer(z: number): FlightLayer {
+    return z >= 6400 ? "dungeons" : "surface";
+}
+
+/** Spectator destinations, not entrances or game travel routes. */
+export class FlightLayers {
+    private saved: Partial<Record<FlightLayer, FlightView>> = {};
+
+    switchTo(layer: FlightLayer, current: FlightView,
+        hasTerrain: (mapX: number, mapZ: number) => boolean): FlightView | undefined {
+        if (flightLayer(current.z) === layer) return undefined;
+        let next = this.saved[layer];
+        if (!next) {
+            const z = current.z + (layer === "dungeons" ? 6400 : -6400);
+            next = { ...current, z };
+            if (!hasTerrain(Math.floor(next.x / 64), Math.floor(z / 64))) {
+                let distance = Infinity;
+                let nearest: FlightView | undefined;
+                for (let mapX = 0; mapX < 100; mapX++) {
+                    for (let mapZ = layer === "dungeons" ? 100 : 0;
+                        mapZ < (layer === "dungeons" ? 200 : 100); mapZ++) {
+                        if (!hasTerrain(mapX, mapZ)) continue;
+                        const x = mapX * 64 + 32, candidateZ = mapZ * 64 + 32;
+                        const d = (x - current.x) ** 2 + (candidateZ - z) ** 2;
+                        if (d < distance) {
+                            distance = d;
+                            nearest = { ...current, x, z: candidateZ };
+                        }
+                    }
+                }
+                if (!nearest) return undefined;
+                next = nearest;
+            }
+        }
+        this.saved[flightLayer(current.z)] = { ...current };
+        return { ...next };
+    }
+}
