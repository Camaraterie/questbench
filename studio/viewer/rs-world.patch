+/** Local relay-to-draw timing, not game-server-to-display latency. */
+export function needsResync(message:{relayObservedAt?:number;relaySnapshot?:boolean},now=Date.now()):boolean {
+ return message.relaySnapshot===false && Number.isFinite(message.relayObservedAt) && message.relayObservedAt!>0 && now-message.relayObservedAt!>2000;
+}
+export class StreamTiming {
+ private pendingAt:number|undefined;
+ private samples:number[]=[];
+ private frameTimes:number[]=[];
+ lastFrameAt=0;
+ applied(at:number){if(at>0)this.pendingAt=at;}
+ reset(){this.pendingAt=undefined;this.samples=[];this.frameTimes=[];this.lastFrameAt=0;}
+ drawn(now=Date.now()){
+  this.lastFrameAt=now;this.frameTimes.push(now);
+  while(this.frameTimes.length && (this.frameTimes[0]<now-2000 || this.frameTimes.length>240))this.frameTimes.shift();
+  if(this.pendingAt!==undefined){this.samples.push(Math.max(0,now-this.pendingAt));if(this.samples.length>120)this.samples.shift();this.pendingAt=undefined;}
+ }
+ snapshot(now=Date.now()){
+  const sorted=[...this.samples].sort((a,b)=>a-b),frames=this.frameTimes.filter(t=>t>=now-2000);
+  return {at:now,lastFrameAt:this.lastFrameAt,localDrawMs:this.samples.length?this.samples[this.samples.length-1]:null,localDrawP95Ms:sorted.length?sorted[Math.ceil(sorted.length*.95)-1]:null,samples:sorted.length,fps:frames.length>1?Math.round((frames.length-1)*1000/Math.max(1,frames[frames.length-1]-frames[0])):0};
+ }
+}
